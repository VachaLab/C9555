; Preprocessing
define 					= <POS_RES>
; Run control
integrator				= steep
nsteps					= 5000
comm-mode				= Linear
nstcomm					= 1
comm-grps				= System
; Energy minimization
emtol					= 10.0
emstep					= 0.01
; Output control
nstlog					= 1000
nstenergy				= 1000
nstxout-compressed			= 1000
compressed-x-precision			= 100
energygrps				=
; Neighbor searching
cutoff-scheme				= Verlet
nstlist					= 20
pbc					= xyz
periodic-molecules			= no
verlet-buffer-tolerance			= 0.005
; Electrostatics
coulombtype				= PME
coulomb-modifier			= None
rcoulomb				= 1.2
epsilon-r				= 1.0
epsilon-rf				= 0.0
; Van der Waals
vdwtype					= Cut-off
vdw-modifier				= Force-Switch
rvdw					= 1.2
rvdw-switch				= 1.0
DispCorr				= no
; Temperature coupling
tcoupl					= no
; Pressure coupling
pcoupl					= no
; Velocity generation
gen-vel					= no
; Bonds
constraints				= none

