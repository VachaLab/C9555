popc: GROUP NDX_FILE=index.ndx NDX_GROUP=POPC UNIQUE
ca: GROUP NDX_FILE=index.ndx NDX_GROUP=CA UNIQUE

center: CENTER ATOMS=popc NOPBC

dist: DISTANCE ATOMS=center,ca COMPONENTS

MOVINGRESTRAINT ...
    LABEL=rest
    ARG=???
    STEP0=???     AT0=???   KAPPA0=???
    STEP1=???     AT1=???   KAPPA1=???
    STEP2=???     AT2=???   KAPPA2=???
...

PRINT STRIDE=5000 ARG=rest.bias,dist.z FILE=DIST
FLUSH STRIDE=100
