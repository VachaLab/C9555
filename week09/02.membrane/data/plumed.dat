# get atom indices of lipid atoms from a GROMACS ndx file
membrane: GROUP NDX_FILE=data/index.ndx NDX_GROUP=MEMBRANE UNIQUE

# calculate the membrane center
c: CENTER ATOMS=membrane NOPBC

# calculate the scaled distances between the box center and water beads
dw0: DISTANCE ATOMS=c,769 SCALED_COMPONENTS
dw1: DISTANCE ATOMS=c,770 SCALED_COMPONENTS
dw2: DISTANCE ATOMS=c,771 SCALED_COMPONENTS
dw3: DISTANCE ATOMS=c,772 SCALED_COMPONENTS
dw4: DISTANCE ATOMS=c,773 SCALED_COMPONENTS
dw5: DISTANCE ATOMS=c,774 SCALED_COMPONENTS
dw6: DISTANCE ATOMS=c,775 SCALED_COMPONENTS
dw7: DISTANCE ATOMS=c,776 SCALED_COMPONENTS
dw8: DISTANCE ATOMS=c,777 SCALED_COMPONENTS
dw9: DISTANCE ATOMS=c,778 SCALED_COMPONENTS

# calculate the scaled distances between the box center and sodium beads
di0: DISTANCE ATOMS=c,2122 SCALED_COMPONENTS
di1: DISTANCE ATOMS=c,2123 SCALED_COMPONENTS
di2: DISTANCE ATOMS=c,2124 SCALED_COMPONENTS
di3: DISTANCE ATOMS=c,2125 SCALED_COMPONENTS
di4: DISTANCE ATOMS=c,2126 SCALED_COMPONENTS
di5: DISTANCE ATOMS=c,2127 SCALED_COMPONENTS
di6: DISTANCE ATOMS=c,2128 SCALED_COMPONENTS
di7: DISTANCE ATOMS=c,2129 SCALED_COMPONENTS
di8: DISTANCE ATOMS=c,2130 SCALED_COMPONENTS
di9: DISTANCE ATOMS=c,2131 SCALED_COMPONENTS

# write the output to a file
PRINT ARG=dw0.c,dw1.c,dw2.c,dw3.c,dw4.c,dw5.c,dw6.c,dw7.c,dw8.c,dw9.c FILE=COLS_WATER
PRINT ARG=di0.c,di1.c,di2.c,di3.c,di4.c,di5.c,di6.c,di7.c,di8.c,di9.c FILE=COLS_IONS
