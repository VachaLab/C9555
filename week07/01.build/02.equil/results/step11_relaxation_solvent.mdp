;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Header
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
title			=	NpT equilibration run
define			=	-DPOSRES -DPOSRES_FC_LIPID=200.0 -DDIHRES -DDIHRES_FC=200.0

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Run control
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
integrator		=	md
dt				=	0.002
nsteps			=	250000
comm-mode		=	Linear
nstcomm			=	100
comm-grps		=	Membrane Solvent

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Output control
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
nstxout			=	0
nstvout			=	0
nstfout			=	0
nstlog			=	10000
nstcalcenergy	=	100
nstenergy		=	1000
nstxout-compressed	=	10000
compressed-x-precision	=	1000
energygprs		=

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Neighbor searching
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
cutoff-scheme	=	Verlet
nstlist			=	20
pbc				=	xyz
verlet-buffer-tolerance	=	0.005

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Electrostatics
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
coulombtype		=	PME
rcoulomb		=	0.9

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Van der Waals
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
vdwtype			=	Cut-off
vdw-modifier	=	None
rvdw			=	0.9
DispCorr		=	EnerPres

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Ewald
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
fourierspacing		=	0.12
pme-order		=	4

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Temperature coupling
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
tcoupl			=	Nose-Hoover
nsttcouple		=	-1
tc-grps			=	Membrane Solvent
tau-t			=	1.0 1.0
ref-t			=	310 310

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Pressure coupling
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
pcoupl			=	Parrinello-Rahman
pcoupltype		=	semiisotropic
nstpcouple		=	-1
tau-p			=	5.0
compressibility	=	4.5e-5 4.5e-5
ref-p			=	1.0 1.0
refcoord-scaling	=	com
;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Velocity generation	;	Optimal				;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
gen-vel			=	no

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Bonds			;	Optimal
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
constraints		=	h-bonds
constraint-algorithm	=	LINCS
continuation	=	yes
lincs-order		=	4
lincs-iter		=	1

