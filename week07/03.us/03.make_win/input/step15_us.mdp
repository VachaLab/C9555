;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Header
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
title			=	NpT equilibration run
define			=	-DFB_CIS -DKAPPA_CIS=500.0

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Run control
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
integrator		=	md
dt				=	0.002
nsteps			=	25000000
comm-mode		=	Linear
nstcomm			=	100
comm-grps		=	Membrane Solvent

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Output control
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
nstxout			=	0
nstvout			=	0
nstfout			=	0
nstlog			=	10000
nstcalcenergy	=	100
nstenergy		=	1000
nstxout-compressed	=	10000
compressed-x-precision	=	1000
energygprs		=

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Neighbor searching
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
cutoff-scheme	=	Verlet
nstlist			=	20
pbc				=	xyz
verlet-buffer-tolerance	=	0.005

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Electrostatics
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
coulombtype		=	PME
rcoulomb		=	0.9

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Van der Waals
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
vdwtype			=	Cut-off
vdw-modifier	=	None
rvdw			=	0.9
DispCorr		=	EnerPres

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Ewald
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
fourierspacing		=	0.12
pme-order		=	4

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Temperature coupling
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
tcoupl			=	Nose-Hoover
nsttcouple		=	-1
tc-grps			=	Membrane Solvent
tau-t			=	1.0 1.0
ref-t			=	310 310

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Pressure coupling
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
pcoupl			=	Parrinello-Rahman
pcoupltype		=	semiisotropic
nstpcouple		=	-1
tau-p			=	5.0
compressibility	=	4.5e-5 4.5e-5
ref-p			=	1.0 1.0
refcoord-scaling	=	all
;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Velocity generation
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
gen-vel			=	no

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Bonds
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
constraints		=	h-bonds
constraint-algorithm	=	LINCS
continuation	=	yes
lincs-order		=	4
lincs-iter		=	1

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; COM Pulling
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
pull 			=	yes

pull-nstxout	=	1000
pull-nstfout	=	1000

pull-pbc-ref-prev-step-com	=	yes

pull-ngroups	=	4
pull-group1-name	=	CIS1
pull-group2-name	=	CIS2
pull-group3-name	=	CIS3
pull-group4-name	=	Lipids
pull-group4-pbcatom	=	11309 ; O1

pull-ncoords	=	3
pull-cylinder-r	=	1.2
pull-coord1-type	=	umbrella
pull-coord1-geometry	=	cylinder
pull-coord1-groups	=	4	1
pull-coord1-dim	=	N N Y
pull-coord1-vec	=	0.0	0.0	1.0
pull-coord1-start	=	no
pull-coord1-init	=	<CV>
pull-coord1-rate	=	0.0
pull-coord1-k		=	1500
pull-coord2-type	=	umbrella
pull-coord2-geometry	=	cylinder
pull-coord2-groups	=	4	2
pull-coord2-dim	=	N N Y
pull-coord2-vec	=	0.0	0.0	1.0
pull-coord2-start	=	no
pull-coord2-init	=	<CV>
pull-coord2-rate	=	0.0
pull-coord2-k		=	1500
pull-coord3-type	=	umbrella
pull-coord3-geometry	=	cylinder
pull-coord3-groups	=	4	3
pull-coord3-dim	=	N N Y
pull-coord3-vec	=	0.0	0.0	1.0
pull-coord3-start	=	no
pull-coord3-init	=	<CV>
pull-coord3-rate	=	0.0
pull-coord3-k		=	1500
