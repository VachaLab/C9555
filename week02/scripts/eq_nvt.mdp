integrator              = md
dt                      = 0.001
nsteps                  = 250000
nstxout                 = 0
nstvout                 = 0
nstfout                 = 0
nstcalcenergy           = 100
nstenergy               = 1000
nstlog                  = 1000
nstxout-compressed      = 500
;
cutoff-scheme           = Verlet
nstlist                 = 20
rlist                   = 1.4
coulombtype             = pme
rcoulomb                = 1.4
vdwtype                 = Cut-off
vdw-modifier            = none
rvdw                    = 1.4
DispCorr 			    = EnerPres
;
tcoupl                  = berendsen
tc_grps                 = system
tau_t                   = 1.0
ref_t                   = 298.15
;
constraints             = h-bonds
constraint_algorithm    = LINCS
;
nstcomm                 = 100
comm_mode               = linear
comm_grps               = system
;
gen-vel                 = yes
gen-temp                = 298.15
gen-seed                = -1
