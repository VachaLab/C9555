; Survival guide to simulations | week5

integrator       = md    ; MD integrator
tinit            = 0     ;
dt               = 0.001 ; 1 fs timestep
nsteps           = 50000 ; 50 ps
pbc              = xyz   ; Periodic boundary conditions in xyz

; OUTPUT CONTROL OPTIONS
nstxtcout        = 10    ;
nstxout          = 10    ;
nstvout          = 10    ;
nstfout          = 10    ;
nstenergy        = 10    ; .edr-file output
ns_type          = grid  ; Fastest option
nstlist          = 10    ; Update neighbor list between cut-offs; increasing this value doesn't yield speedup (rather a bit slower)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
comm-mode        = angular  ;
nstcomm          = 100      ; COM motion removal
comm-grps        = system   ;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; OPTIONS FOR ELECTROSTATICS AND VDW
cutoff-scheme    = verlet     ; group is alternative
coulombtype      = PME        ; Particle mesh Ewald, do not change
rcoulomb         = 0.8        ; Real-space cut-off
vdwtype          = cut-off    ;
vdw-modifier     = potential-shift-verlet   ; =shifted-vdw with Verlet_cutoff_scheme, =none with grid_cutoff_scheme
rvdw             = 0.8        ; VdW cut-off, orig paper rvdw=1.4, but this value is still fine (tested for both rigbonds an VSites, almost identical)
DispCorr         = EnerPres   ; Dispersion corrections to both the potential and pressure
table-extension  = 0.8
fourierspacing   = 0.12       ; PME grid

; OPTIONS FOR WEAK COUPLING ALGORITHMS 
tcoupl           = berendsen  ; Thermostat, v-rescale or nose-hoover is also fine
tc-grps          = system     ; Couple lipids and Water_and_ions seperatly
tau-t            = 0.1        ; Time constant for temperature coupling
ref-t            = 310        ; Desired temperature (K)

; Pcoupl          = parrinello-rahman  ; Barostat
Pcoupltype       = semiisotropic      ; Pressure in xy and z couple separately
ref-p            = 1.013 1.013        ; Desired pressure (bar)
tau-p            = 10.0               ; Time constant for pressure coupling
compressibility  = 4.5e-5 4.5e-5      ; Same as for water

; CONSTRAINTS
; constraints    = hbonds
constraint-algorithm     = Lincs
lincs-order      = 5    ; Increasing these does not make much change to the precision of virtual sites (J. Melcr)
lincs-iter       = 2    ; 5,2 conserves energy in NVE well enough (J. Melcr)
