integrator              = md
dt                      = 0.002
nsteps                  = 500000
nstxout                 = 0
nstvout                 = 0
nstfout                 = 0
nstcalcenergy           = 100
nstenergy               = 1000
nstlog                  = 1000
nstxout-compressed      = 5000
;
cutoff-scheme           = Verlet
nstlist                 = 20
rlist                   = 1.4
coulombtype             = pme
rcoulomb                = 1.4
vdwtype                 = Cut-off
vdw-modifier            = none
rvdw                    = 1.4
DispCorr                = EnerPres
;
tcoupl                  = Nose-Hoover
tc_grps                 = system
tau_t                   = 2.0
ref_t                   = 298.15
;
pcoupl                  = Parrinello-Rahman
pcoupltype              = isotropic
tau_p                   = 2.0
compressibility         = 4.5e-5
ref_p                   = 1.0
;
constraints             = h-bonds
constraint_algorithm    = LINCS
continuation            = yes
;
nstcomm                 = 100
comm_mode               = linear
comm_grps               = system
